		<link rel="stylesheet" href="/local/templates/main/css/wheel.css?1774376105">
<script>
	function showWheelForm() {
		$.fancybox.open({
			src: "/ajax/wheel.php",
			type: "ajax",
			touch: false,
			ajax: {
				settings: {
					type: "POST",
				}
			},
			beforeShow: function() {
				$('.fancybox-bg').addClass('fancybox-bg_grey');
			},
		});
	}
	
	function wheelForm() {
		var isWheelFormFilled = getCookie('isWheelFormFilled'),
			maxAge = 365*86400;

		if (isWheelFormFilled !== "true") {
			showWheelForm();
		}
	}
	
	var canDrawWheel = true,
		isFormWheelFilled = getCookie('isWheelFormFilled');
	if (
		(isFormWheelFilled === true) ||
		(isFormWheelFilled === 'true') ||
		(isFormWheelFilled === 1) ||
		(isFormWheelFilled === '1')
	) {
		canDrawWheel = false;
	}
	if (canDrawWheel) {
		setTimeout(
			wheelForm,
			5000
		);
	}
	
	$(document).on("change", ".js-fortune-wheel-rules-input", function(e) {
		checkCanUseWheel();
	});
	
	function checkCanUseWheel() {
		var phone = $('.js-wheel-form-phone').val(),
			phoneNumberCount = phone.replace(/[^0-9]/g,"").length;
		if (
			(phoneNumberCount === 11) &&
			$('.js-fortune-wheel-rules-input').is(':checked')
		) {
			$('.js-fortune-wheel-action-item-run-btn').prop('disabled', false);
		} else {
			$('.js-fortune-wheel-action-item-run-btn').prop('disabled', true);
		}
	}
	
	function drawWheel() {
		const prizes = [{'text':'Скидка 10% на абонемент — получите выгодную цену на тренировочный пакет!','htmlStr':'<span class=\"fortune-wheel__text-big\">Скидка 10%<\/span><br> получите выгодную цену<br> на тренировочный пакет!','color':'hsl(40 93% 79%)','textColor':'#000000','width':'260px'},{'text':'Неделя тренировок бесплатно — пробуйте без ограничений весь наш зал в течение 7 дней','htmlStr':'<span class=\"fortune-wheel__text-medium\">Неделя тренировок<\/span><br> <span class=\"fortune-wheel__text-big\">бесплатно<\/span><br> <span>пробуйте без ограничений<\/span><br> <span>весь наш зал<\/span><br> <span>в течение 7 дней<\/span>','color':'hsl(0 0% 22%)','textColor':'#FFFFFF','width':'260px'},{'text':'Приведи друга — тренировка для него бесплатно — делитесь спортом вместе!','htmlStr':'<span class=\"fortune-wheel__text-medium\">Приведи друга <br>— тренировка для него<\/span><br><span class=\"fortune-wheel__text-big\">бесплатно<\/span><br>делитесь спортом вместе!','color':'hsl(40 93% 79%)','textColor':'#000000','width':'260px'},{'text':'3 бесплатные групповые тренировки — начните заниматься уже сегодня!','htmlStr':'<span class=\"fortune-wheel__text-medium\">3 бесплатные групповые<br>тренировки начните <br>заниматься<br>уже сегодня!<\/span>','color':'hsl(0 0% 22%)','textColor':'#FFFFFF','width':'260px'},{'text':'Персональная тренировка бесплатно — попробуйте индивидуальный подход с нашим тренером.','htmlStr':'<span class=\"fortune-wheel__text-medium\">Персональная тренировка<\/span><br><span class=\"fortune-wheel__text-big\">бесплатно<\/span><br>попробуйте индивидуальный<br> подход<br> с нашим тренером.','color':'hsl(40 93% 79%)','textColor':'#000000','width':'260px'},{'text':'Подарок при первой покупке абонемента — спортивный аксессуар или приятный бонус','htmlStr':'<span class=\"fortune-wheel__text-medium\">Подарок при первой покупке<br> абонемента<\/span><br><span class=\"fortune-wheel__text-big\">подарок<\/span><br> спортивный аксессуар <br>или приятный бонус','color':'hsl(0 0% 22%)','textColor':'#FFFFFF','width':'260px'}];

		const wheel = document.querySelector(".deal-wheel");
		const spinner = wheel.querySelector(".spinner");
		const trigger = document.querySelector(".js-fortune-wheel-action-item-run-btn");
		const agreement = document.querySelector(".js-fortune-wheel-rules-input");
		const ticker = wheel.querySelector(".ticker");

		const prizeSlice = 360 / prizes.length;
		const prizeOffset = Math.floor(180 / prizes.length);
		const spinClass = "is-spinning";
		const selectedClass = "selected";
		const spinnerStyles = window.getComputedStyle(spinner);

		let tickerAnim;
		let rotation = 0;
		let currentSlice = 0;
		let prizeNodes;

		const createPrizeNodes = () => {
		  prizes.forEach(({ text, htmlStr, color, textColor, width, reaction }, i) => {
			const rotation = ((prizeSlice * i) * -1) - prizeOffset;
			spinner.insertAdjacentHTML(
			  "beforeend",
			  `<li class="prize" data-reaction=${reaction} style="--rotate: ${rotation}deg" data-id="${i}"><p class="text" style="color: ${textColor};">${htmlStr}</p></li>`
			);
		  });
		};

		const createConicGradient = () => {
		  spinner.setAttribute(
			"style",
			`background: conic-gradient(
			  from -90deg,
			  ${prizes
				.map(({ color }, i) => `${color} 0 ${(100 / prizes.length) * (prizes.length - i)}%`)
				.reverse()
			  }
			);`
		  );
		};
		const setupWheel = () => {
		  createConicGradient();
		  createPrizeNodes();
		  prizeNodes = wheel.querySelectorAll(".prize");
		};

		const spinertia = (min, max) => {
		  min = Math.ceil(min);
		  max = Math.floor(max);
		  return Math.floor(Math.random() * (max - min + 1)) + min;
		};

		const runTickerAnimation = () => {
		  const values = spinnerStyles.transform.split("(")[1].split(")")[0].split(",");
		  const a = values[0];
		  const b = values[1];  
		  let rad = Math.atan2(b, a);
		  
		  if (rad < 0) rad += (2 * Math.PI);
		  
		  const angle = Math.round(rad * (180 / Math.PI));
		  const slice = Math.floor(angle / prizeSlice);

		  if (currentSlice !== slice) {
			ticker.style.animation = "none";
			setTimeout(() => ticker.style.animation = null, 10);
			currentSlice = slice;
		  }
		  tickerAnim = requestAnimationFrame(runTickerAnimation);
		};

		const selectPrize = () => {
		  const selected = Math.floor(rotation / prizeSlice);
		  prizeNodes[selected].classList.add(selectedClass);
		  setCookie('prizeId', prizeNodes[selected].dataset.id, {secure: true, 'max-age': 5});
		};

		trigger.addEventListener("click", () => {
		  trigger.disabled = true;
		  agreement.disabled = true;
		  rotation = Math.floor(Math.random() * 360 + spinertia(2000, 5000));
		  prizeNodes.forEach((prize) => prize.classList.remove(selectedClass));
		  wheel.classList.add(spinClass);
		  spinner.style.setProperty("--rotate", rotation);
		  ticker.style.animation = "none";
		  runTickerAnimation();
		});

		spinner.addEventListener("transitionend", () => {
		  cancelAnimationFrame(tickerAnim);
		  rotation %= 360;
		  selectPrize();
		  wheel.classList.remove(spinClass);
		  spinner.style.setProperty("--rotate", rotation);
		  setTimeout(() => {
				$('.js-wheel-form-btn').trigger('click');
		  }, 1000);
		});

		setupWheel();
	}
</script>
<script src="/local/templates/main/plugins/Inputmask-5.x/dist/jquery.inputmask.js"></script>		    </body>
</html>